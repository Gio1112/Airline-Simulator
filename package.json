{
  "name": "airline-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-source": "node scripts/prepare-source.mjs",
    "dev": "node scripts/prepare-source.mjs && next dev",
    "sync-airports": "node scripts/sync-airports.mjs",
    "build": "node scripts/prepare-source.mjs && node scripts/sync-airports.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "maplibre-gl": "5.24.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "wrangler": "4.129.0"
  }
}
